# ===================================================================
# EXAMPLE CONFIGURATION TEMPLATE - Car Rental Management System
# Copy this file or set corresponding environment variables before running.
# DO NOT insert real credentials into version control.
# ===================================================================

# Server Port
SERVER_PORT=8080

# Database Connection Variables
DB_URL=jdbc:mysql://localhost:3306/car_rental_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here

# Individual Database Connection Parts (Optional alternative to DB_URL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=car_rental_db

# Hibernate / JPA Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
LOG_SQL_LEVEL=INFO

# JWT Authentication Configuration (Must be at least 32 characters / 256 bits)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security_example
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
